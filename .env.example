# ==========================================
# GEMINI & CHATBOT API (VERCEL ENVIRONMENT VARIABLES)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash

# ==========================================
# SUPABASE AUTH & DATABASE (VERCEL ENVIRONMENT VARIABLES)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_JWT_SECRET=your_server_only_jwt_secret

# ==========================================
# FRONTEND CONFIGURATION (PUBLIC CLIENT SAFE)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
# Optional external backend override (leave unset on Vercel to use relative same-origin /api/... calls)
# VITE_API_URL=

# ==========================================
# LOCAL DEVELOPMENT SERVER (LOCAL RUN ONLY)
# ==========================================
PORT=8000
HOST=0.0.0.0
MENU_FILE_PATH=coffee_agent/data/menu.json
CUSTOMERS_FILE_PATH=coffee_agent/data/customers.json
