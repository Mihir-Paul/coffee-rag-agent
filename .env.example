# ==========================================
# CHATBOT / GEMINI API (RENDER BACKEND SECRET)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash

# ==========================================
# GOOGLE CLOUD RAG (OPTIONAL / BACKEND ONLY)
# ==========================================
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
RAG_CORPUS_NAME=projects/your_gcp_project_id/locations/us-central1/ragCorpora/coffee_shop_kb

# ==========================================
# SUPABASE (RENDER BACKEND SECRETS)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
SUPABASE_JWT_SECRET=your_server_only_jwt_secret

# ==========================================
# SERVER CONFIGURATION (RENDER BACKEND)
# ==========================================
PORT=8000
HOST=0.0.0.0
# Allowed origins for CORS (e.g., your Vercel deployment URL):
FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=https://your-app.vercel.app

# ==========================================
# FRONTEND CONFIGURATION (VERCEL FRONTEND SAFE)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
VITE_API_BASE_URL=https://your-backend.onrender.com

# ==========================================
# LOCAL DATA PATHS (OPTIONAL OVERRIDES)
# ==========================================
MENU_FILE_PATH=coffee_agent/data/menu.json
CUSTOMERS_FILE_PATH=coffee_agent/data/customers.json
