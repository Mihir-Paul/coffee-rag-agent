# Render Backend URL (Do NOT include a trailing slash)
# Used by frontend to construct ${VITE_API_URL}/api/chat
VITE_API_URL=https://your-render-service.onrender.com

# Secondary / fallback alias for backend URL
VITE_API_BASE_URL=https://your-render-service.onrender.com

# Supabase Public Client Credentials (Safe for browser client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
